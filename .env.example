# Public base URL of this deployed app, e.g. https://your-app.vercel.app
APP_URL=http://localhost:3000

# LinkedIn Developer App > Auth settings
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the redirect URL registered in LinkedIn
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# OpenAI API key. The workflow uses Responses API with web_search for research.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Supabase project dedicated to this automation; never use a public/anon key here
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte encryption key, represented as 64 hex chars; keep stable and back it up securely
TOKEN_ENCRYPTION_KEY=

# Random secret (at least 32 chars) used to protect the cron endpoint
CRON_SECRET=
# Optional alert endpoint (Slack/Teams incoming webhook, etc.)
ALERT_WEBHOOK_URL=
